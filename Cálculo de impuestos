#Pide al usuario su salario mensual y aplica los siguientes impuestos:
#○ Menos de 10,000: 0%
#○ Entre 10,000 y 30,000: 10%
#○ Más de 30,000: 20%
def calcular_impuesto(salario):
    if salario < 10000:
        return 0
    elif 10000 <= salario <= 30000:
        return salario * 0.10
    else:
        return salario * 0.20
salario = float(input("Introduce tu salrio mensual:"))
impuesto = calcular_impuesto(salario)
print(f"El impuesto a pagar es: {impuesto}")