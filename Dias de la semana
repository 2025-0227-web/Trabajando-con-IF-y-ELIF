# Escribe un programa que solicite un número del 1 al 7 y muestre el día de la
#semana correspondiente (1 es lunes, 7 es domingo).
dia=int(input("introduce un numero del 1 al 7:"))
if dia<1 or dia>7:
    print("numero incorrecto")
elif dia==1:
    print("Lunes")
elif dia==2:
    print("Martes")
elif dia==3:
    print("Miercoles")
elif dia==4:
    print("Jueves")
elif dia==5:
    print("Viernes")
elif dia==6:
    print("sabado")
elif dia==7:
    print("Domingo")
    

